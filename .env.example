NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=replace-with-local-database-owner-password
EDUCONNECT_APP_PASSWORD=replace-with-local-runtime-role-password
EDUCONNECT_PLATFORM_PASSWORD=replace-with-local-platform-role-password
MIGRATION_DATABASE_URL=postgresql://educonnect:replace-with-local-database-owner-password@localhost:5432/educonnect
DATABASE_URL=postgresql://educonnect_app:replace-with-local-runtime-role-password@localhost:5432/educonnect
PLATFORM_DATABASE_URL=postgresql://educonnect_platform:replace-with-local-platform-role-password@localhost:5432/educonnect
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-32-byte-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BOOTSTRAP_ADMIN_EMAIL=admin@calmstacks.example
BOOTSTRAP_ADMIN_PASSWORD=replace-before-bootstrap
BOOTSTRAP_ADMIN_NAME=CalmStacks Platform Admin
INVITATION_BASE_URL=http://localhost:5173/accept-invitation
RECOVERY_BASE_URL=http://localhost:5173/recover-account
INVITATION_TTL_HOURS=72
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EduConnect <no-reply@example.com>
