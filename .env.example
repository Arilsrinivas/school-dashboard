NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=replace-with-local-database-owner-password
EDUCONNECT_APP_PASSWORD=replace-with-local-runtime-role-password
EDUCONNECT_PLATFORM_PASSWORD=replace-with-local-platform-role-password
MIGRATION_DATABASE_URL=postgresql://educonnect:replace-with-local-database-owner-password@localhost:5432/educonnect
EDUCONNECT_DATABASE_PROJECT_REF=replace-with-supabase-project-reference
DATABASE_SSL_CA_CERT_PATH=.secrets/supabase-root.crt
DATABASE_URL=postgresql://educonnect_app:replace-with-local-runtime-role-password@localhost:5432/educonnect
PLATFORM_DATABASE_URL=postgresql://educonnect_platform:replace-with-local-platform-role-password@localhost:5432/educonnect
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
REFRESH_TOKEN_SECRET=replace-with-a-different-32-byte-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BOOTSTRAP_ADMIN_EMAIL=admin@calmstacks.example
BOOTSTRAP_ADMIN_FIREBASE_UID=replace-with-verified-firebase-user-uid
BOOTSTRAP_ADMIN_NAME=CalmStacks Platform Admin
INVITATION_BASE_URL=http://localhost:5173/accept-invitation
RECOVERY_BASE_URL=http://localhost:5173/recover-account
INVITATION_TTL_HOURS=72
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EduConnect <no-reply@example.com>

# Google Identity Services / OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=680544077722-48ohflm900bhfvc5s09og4fq1b88416.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# Firebase Authentication — Firebase ID tokens are required in production.
AUTH_PROVIDER=legacy
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=your-firebase-project-id
# Server-only service-account JSON. Replace only in ignored .env or a secret manager.
FIREBASE_SERVICE_ACCOUNT_JSON=replace-with-complete-firebase-service-account-json

# Firebase Cloud Storage bucket. Create a private bucket in educonnect-44f2b.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
