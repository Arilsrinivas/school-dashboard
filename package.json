{
  "name": "calmstacks-educonnect",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build --workspace apps/api && npm run build --workspace apps/web",
    "build:api": "esbuild api/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "vercel-build": "npm run build --workspace apps/api && npm run build --workspace apps/web && esbuild api/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "firebase:deploy": "npm run build && firebase deploy --only hosting",
    "test": "npm run test --workspace apps/api",
    "test:e2e": "npm --workspace apps/api run test:e2e",
    "db:migrate": "npm --workspace apps/api run db:migrate",
    "db:bootstrap-admin": "npm --workspace apps/api run db:bootstrap-admin",
    "db:clean-demo": "tsx scripts/clean-demo-data.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
