{
  "name": "@educonnect/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:bootstrap-admin": "tsx src/auth/bootstrap.ts",
    "test": "tsx --test src/auth/security.test.ts src/db/tenant-isolation.test.ts src/homework/homework.integration.test.ts src/exams/exams.integration.test.ts src/timetable/timetable.integration.test.ts src/fees/fees.integration.test.ts src/announcements/announcements.integration.test.ts src/reports/reports.integration.test.ts",
    "test:e2e": "tsx --test src/e2e/e2e-workflow.test.ts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  }
}
